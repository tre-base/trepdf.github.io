---
import Base from '../layouts/Base.astro';
import Downloads from '../components/Downloads.astro';
import Guides from '../components/Guides.astro';
import Icon from '../components/Icon.astro';
import { articles, type Article } from '../data/articles';
import { href, route, languages, navigation, asset, type Lang } from '../data/site';
export function getStaticPaths() {
  return [
    ...articles.map(article => ({ params: { slug: article.slug }, props: { kind: 'article', article, lang: article.lang } })),
    ...languages.flatMap(lang => ['download','guides'].map(kind => ({ params: { slug: route(kind,lang) }, props: { kind, lang, article: undefined } }))),
  ];
}
const { kind, article, lang } = Astro.props as { kind: string; article?: Article; lang: Lang };
const vi = lang==='vi';
---
{kind==='download' ? <Downloads lang={lang}/> : kind==='guides' ? <Guides lang={lang}/> : article && <Base lang={lang} pageId={article.id} title={article.title} description={article.description}>
  <div class="container article-heading"><a class="text-link breadcrumb" href={href('guides',lang)}>{vi?'Hướng dẫn & tính năng':'Guides & features'}<Icon name="right"/></a><h1>{article.heading}</h1><p>{article.intro}</p></div>
  <div class="container article-layout">
    <aside class="article-toc"><p>{vi?'Trong trang này':'On this page'}</p><nav aria-label={vi?'Mục lục':'On this page'}>{article.sections.map((s,i)=><a href={`#section-${i+1}`}>{s.heading}</a>)}</nav></aside>
    <article class="article-body">
      {article.id==='editor' && <figure><img src={asset('images/app-editor.webp')} alt={vi?'Sửa văn bản trong TrePDF với bảng định dạng':'Editing text in TrePDF with the formatting panel'} width="1440" height="960"/><figcaption>{vi?'Ảnh ứng dụng thật với tài liệu mẫu.':'The actual application with a sample document.'}</figcaption></figure>}
      {article.sections.map((s,i)=><section id={`section-${i+1}`}><h2>{s.heading}</h2>{s.paragraphs?.map(p=><p>{p}</p>)}{s.items && <ul>{s.items.map(item=><li>{item}</li>)}</ul>}</section>)}
      {article.id==='privacy' && <p><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">{vi?'Chính sách quyền riêng tư của GitHub':'GitHub’s privacy statement'}<Icon name="arrow"/></a></p>}
      {article.related.length>0 && <div class="article-related"><h2>{navigation[lang].related}</h2>{article.related.map(id=><a class="text-link" href={href(id,lang)}>{articles.find(a=>a.id===id&&a.lang===lang)?.heading ?? id}<Icon name="right"/></a>)}</div>}
    </article>
  </div>
</Base>}
