---
import Base from '../layouts/Base.astro';
import Downloads from '../components/Downloads.astro';
import Guides from '../components/Guides.astro';
import Contact from '../components/Contact.astro';
import EditorFeature from '../components/EditorFeature.astro';
import FormFeature from '../components/FormFeature.astro';
import OCRFeature from '../components/OCRFeature.astro';
import Icon from '../components/Icon.astro';
import { articles, type Article } from '../data/articles';
import { href, route, languages, navigation, pageLabels, type Lang } from '../data/site';
export function getStaticPaths() {
  return [
    ...articles.map(article => ({ params: { slug: article.slug }, props: { kind: 'article', article, lang: article.lang } })),
    ...languages.flatMap(lang => ['download','guides','contact'].map(kind => ({ params: { slug: route(kind,lang) }, props: { kind, lang, article: undefined } }))),
  ];
}
const { kind, article, lang } = Astro.props as { kind: string; article?: Article; lang: Lang };
const labels = pageLabels[lang];
---
{kind==='contact' ? <Contact lang={lang}/> : kind==='download' ? <Downloads lang={lang}/> : kind==='guides' ? <Guides lang={lang}/> : article?.id==='editor' ? <EditorFeature article={article}/> : article?.id==='forms' ? <FormFeature article={article}/> : article?.id==='ocr' ? <OCRFeature article={article}/> : article && <Base lang={lang} pageId={article.id} title={article.title} description={article.description}>
  <div class="container article-heading"><a class="text-link breadcrumb" href={href('guides',lang)}>{labels.breadcrumb}<Icon name="right"/></a><h1>{article.heading}</h1><p>{article.intro}</p></div>
  <div class="container article-layout">
    <aside class="article-toc"><p>{labels.toc}</p><nav aria-label={labels.toc}>{article.sections.map((s,i)=><a href={`#section-${i+1}`}>{s.heading}</a>)}</nav></aside>
    <article class="article-body">
      {article.sections.map((s,i)=><section id={`section-${i+1}`}><h2>{s.heading}</h2>{s.paragraphs?.map(p=><p>{p}</p>)}{s.items && <ul>{s.items.map(item=><li>{item}</li>)}</ul>}</section>)}
      {article.id==='privacy' && <p><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">{labels.githubPrivacy}<Icon name="arrow"/></a></p>}
      {article.related.length>0 && <div class="article-related"><h2>{navigation[lang].related}</h2>{article.related.map(id=><a class="text-link" href={href(id,lang)}>{articles.find(a=>a.id===id&&a.lang===lang)?.heading ?? id}<Icon name="right"/></a>)}</div>}
    </article>
  </div>
</Base>}
