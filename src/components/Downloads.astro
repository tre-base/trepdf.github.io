---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import downloads from '../data/downloads.json';
import { href, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = {
  "en": {
    "title": "Download TrePDF Desktop PDF Editor | TrePDF",
    "description": "Find TrePDF desktop download options for macOS, Windows and Linux. Download links and system requirements will be added when packages are available.",
    "eyebrow": "Your PDF workspace",
    "heading": "TrePDF, on your desktop.",
    "intro": "Choose your platform. Download links will appear here when release packages are ready.",
    "platforms": "Download platforms",
    "requirements": "System requirements will be listed with the download.",
    "version": "Version",
    "download": "Download",
    "unavailable": "Not available yet",
    "noticeHeading": "While you’re here, get to know TrePDF.",
    "noticeCopy": "Explore how to edit text, download missing fonts, and create a searchable PDF from a scan.",
    "guides": "Browse the guides"
  },
  "vi": {
    "title": "Tải TrePDF cho máy tính | TrePDF",
    "description": "Xem các lựa chọn tải TrePDF cho macOS, Windows và Linux. Đường dẫn tải và yêu cầu hệ thống sẽ được bổ sung khi gói phát hành sẵn sàng.",
    "eyebrow": "Không gian PDF của bạn",
    "heading": "TrePDF, trên máy của bạn.",
    "intro": "Chọn nền tảng của bạn. Đường dẫn tải sẽ xuất hiện tại đây khi các gói phát hành sẵn sàng.",
    "platforms": "Các nền tảng tải xuống",
    "requirements": "Yêu cầu hệ thống sẽ được công bố cùng bản tải.",
    "version": "Phiên bản",
    "download": "Tải xuống",
    "unavailable": "Chưa có bản tải",
    "noticeHeading": "Trong lúc chờ, làm quen với TrePDF.",
    "noticeCopy": "Khám phá cách sửa văn bản, tải font còn thiếu và tạo PDF tìm kiếm được từ bản scan.",
    "guides": "Xem hướng dẫn"
  },
  "th": {
    "title": "ดาวน์โหลด TrePDF โปรแกรมแก้ไข PDF สำหรับเดสก์ท็อป | TrePDF",
    "description": "ดูตัวเลือกการดาวน์โหลด TrePDF สำหรับ macOS, Windows และ Linux ลิงก์ดาวน์โหลดและความต้องการของระบบจะเพิ่มเข้ามาเมื่อแพ็กเกจพร้อมเผยแพร่",
    "eyebrow": "พื้นที่ทำงาน PDF ของคุณ",
    "heading": "TrePDF บนคอมพิวเตอร์ของคุณ",
    "intro": "เลือกแพลตฟอร์มของคุณ ลิงก์ดาวน์โหลดจะปรากฏที่นี่เมื่อแพ็กเกจพร้อมเผยแพร่",
    "platforms": "แพลตฟอร์มที่ดาวน์โหลดได้",
    "requirements": "ความต้องการของระบบจะระบุไว้พร้อมกับไฟล์ดาวน์โหลด",
    "version": "เวอร์ชัน",
    "download": "ดาวน์โหลด",
    "unavailable": "ยังไม่พร้อมให้ดาวน์โหลด",
    "noticeHeading": "ระหว่างรอ มาทำความรู้จัก TrePDF กัน",
    "noticeCopy": "เรียนรู้วิธีแก้ไขข้อความ ดาวน์โหลดฟอนต์ที่ขาดหาย และสร้าง PDF ที่ค้นหาข้อความได้จากภาพสแกน",
    "guides": "ดูคู่มือ"
  },
  "fr": {
    "title": "Télécharger TrePDF, éditeur PDF pour ordinateur | TrePDF",
    "description": "Découvrez les téléchargements de TrePDF pour macOS, Windows et Linux. Les liens et la configuration requise seront ajoutés lorsque les fichiers d’installation seront disponibles.",
    "eyebrow": "Votre espace de travail PDF",
    "heading": "TrePDF, sur votre ordinateur.",
    "intro": "Choisissez votre plateforme. Les liens de téléchargement apparaîtront ici dès que les fichiers d’installation seront prêts.",
    "platforms": "Plateformes de téléchargement",
    "requirements": "La configuration requise sera indiquée avec le téléchargement.",
    "version": "Version",
    "download": "Télécharger",
    "unavailable": "Pas encore disponible",
    "noticeHeading": "En attendant, découvrez TrePDF.",
    "noticeCopy": "Apprenez à modifier du texte, à télécharger les polices manquantes et à créer un PDF consultable par recherche à partir d’un document numérisé.",
    "guides": "Consulter les guides"
  }
}[lang];
---
<Base lang={lang} pageId="download" title={t.title} description={t.description}>
  <div class="container page-heading"><p class="eyebrow">{t.eyebrow}</p><h1>{t.heading}</h1><p>{t.intro}</p></div>
  <section class="container download-section" aria-label={t.platforms}>
    <div class="download-grid">{downloads.map(d => <article class="download-card" data-download-id={d.id}>
      <Icon name="device"/><p class="download-arch">{d.architecture}</p><h2>{d.os}</h2>
      <p class="small-text">{d.requirements || t.requirements}</p>
      {d.version && <p>{t.version} {d.version}</p>}
      {d.url ? <a class="button" href={d.url}>{t.download}<Icon name="download"/></a> : <button class="button unavailable" disabled type="button">{t.unavailable}</button>}
    </article>)}</div>
    <div class="notice"><Icon name="book"/><div><h2>{t.noticeHeading}</h2><p>{t.noticeCopy}</p><a class="text-link" href={href('guides',lang)}>{t.guides}<Icon name="right"/></a></div></div>
  </section>
</Base>
