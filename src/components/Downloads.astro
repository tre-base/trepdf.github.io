const groups = [
  { heading: t.available, items: downloads.filter(d => d.url) },
  { heading: t.pending, items: downloads.filter(d => !d.url) }
].filter(group => group.items.length > 0);
---
<Base lang={lang} pageId="download" title={t.title} description={t.description}>
  <div class="container page-heading"><p class="eyebrow">{t.eyebrow}</p><h1>{t.heading}</h1><p>{t.intro}</p></div>
  <section class="container download-section" aria-label={t.platforms}>
    <article class="download-card macos-download" data-download-id="mac-arm" data-macos-download aria-labelledby="apple-silicon-heading">
      <div class="macos-download-heading">
        <Icon name="device"/>
        <p class="download-arch">macOS · {t.beta}</p>
        <h2 id="apple-silicon-heading">Apple Silicon <span>(M1/M2/M3/M4/M5/M6)</span></h2>
      </div>
      <div class="macos-download-picker">
        <label for="macos-version">{t.selectLabel}</label>
        <select id="macos-version" name="macos-version" data-macos-version aria-describedby="macos-version-help" disabled>
          <option value="">{t.selectPlaceholder}</option>
          {macosDownloads.map(os => <option value={os.id} data-url={os.url} data-version={os.version}>macOS {os.id} {os.name}</option>)}
        </select>
        <p class="macos-version-help" id="macos-version-help">{t.selectHelp}</p>
        <div class="macos-download-status" aria-live="polite" aria-atomic="true">
          <p class="macos-select-hint" data-macos-hint>{t.selectHint}</p>
          {macosDownloads.map(os => <div data-macos-result={os.id} hidden>
            <p class="macos-selected-version">macOS {os.id} {os.name}</p>
            {os.version && <p class="macos-release-version">{t.version} {os.version} · {t.beta}</p>}
            {os.url
              ? <a class="button" href={os.url} aria-label={`${t.download}: Apple Silicon, macOS ${os.id} ${os.name}`}>{t.download}<Icon name="download"/></a>
              : <button class="button unavailable" disabled type="button">{t.linkPending}</button>}
          </div>)}
        </div>
        <noscript><p class="macos-version-help">{t.noScript}</p></noscript>
      </div>
    </article>
    {groups.map(group => <div class="download-group">
      <h2>{group.heading}</h2>
      <div class="download-grid">{group.items.map(d => <article class="download-card" data-download-id={d.id}>
        <Icon name="device"/><p class="download-arch">{d.architecture}</p><h3>{d.os}</h3>
        <p class="small-text">{d.requirements || t.requirements}</p>
        {d.version && <p>{t.version} {d.version} · {t.beta}</p>}
        {d.url ? <a class="button" href={d.url} aria-label={`${t.download}: TrePDF ${d.architecture}, ${d.requirements}`}>{t.download}<Icon name="download"/></a> : <button class="button unavailable" disabled type="button">{t.unavailable}</button>}
      </article>)}</div>
    </div>)}
    <div class="notice"><Icon name="book"/><div><h2>{t.noticeHeading}</h2><p>{t.noticeCopy}</p><a class="text-link" href={href('guides',lang)}>{t.guides}<Icon name="right"/></a></div></div>
  </section>
</Base>

<script>
  for (const card of document.querySelectorAll<HTMLElement>('[data-macos-download]')) {
    const select = card.querySelector<HTMLSelectElement>('[data-macos-version]');
    const hint = card.querySelector<HTMLElement>('[data-macos-hint]');
    const results = card.querySelectorAll<HTMLElement>('[data-macos-result]');
    if (!select || !hint) continue;
    const updateSelection = () => {
      let hasSelection = false;
      for (const result of results) {
        const selected = result.dataset.macosResult === select.value;
        result.hidden = !selected;
        hasSelection ||= selected;
      }
      hint.hidden = hasSelection;
    };
    select.disabled = false;
    select.addEventListener('change', updateSelection);
    window.addEventListener('pageshow', updateSelection);
    updateSelection();
  }
</script>
