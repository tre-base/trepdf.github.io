---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import FeatureDemos from './FeatureDemos.astro';
import { homeCopy } from '../data/home';
import { href, asset, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = homeCopy[lang];
---
<Base lang={lang} pageId="home" title={t.title} description={t.description}>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span>{t.eyebrow}</p>
      <h1>{t.headline}<br/><span>{t.accent}</span></h1>
      <p class="hero-intro">{t.intro}</p>
      <div class="hero-actions"><a class="button" href={href('download', lang)}>{t.primary}<Icon name="download"/></a><a class="text-link" href={href('editor', lang)}>{t.secondary}<Icon name="right"/></a></div>
      <p class="platforms"><Icon name="device"/>{t.platforms}</p>
      <p class="availability">{t.availability}</p>
    </div>
    <figure class="hero-visual">
      <div class="image-backdrop"></div>
      <a class="app-frame" href={href('editor', lang)} aria-label={t.secondary}><img src={asset('images/app-editor.webp')} alt={t.screenshot} width="1440" height="960" fetchpriority="high" loading="eager" /></a>
      <figcaption>{t.screenshotCaption}</figcaption>
    </figure>
  </section>
  <div class="container benefits">{t.benefits.map(b => <span><Icon name="check"/>{b}</span>)}</div>
  <section class="section container" id="features">
    <div class="section-heading"><h2 class="preserve-lines">{t.featureTitle}</h2><p>{t.featureIntro}</p></div>
    <FeatureDemos lang={lang}/>
  </section>
  <section class="font-section">
    <div class="container font-grid">
      <div><p class="eyebrow">{t.fontEyebrow}</p><h2 class="preserve-lines">{t.fontTitle}</h2><p class="section-intro">{t.fontText}</p><a class="text-link" href={href('fonts', lang)}>{t.fontLink}<Icon name="right"/></a></div>
      <div class="type-study" aria-hidden="true"><span class="type-large">Aa<span class="type-period">.</span></span><div class="type-specimen"><span>{t.fontStyles[0]}</span><strong>{t.fontStyles[1]}</strong><em>{t.fontStyles[2]}</em></div><p>{t.fontSampleLabel}</p></div>
      <ol class="font-steps">{t.fontSteps.map(([title, description], i) => <li><span class="step-num">{i+1}</span><div><h3>{title}</h3><p>{description}</p></div></li>)}</ol>
      <p class="font-note">{t.fontNote}</p>
    </div>
  </section>
  <section class="section container">
    <div class="section-heading"><h2>{t.toolkitTitle}</h2><p>{t.toolkitIntro}</p></div>
    <div class="tools-grid">{t.tools.map(tool => <article><Icon name={tool.icon as 'pages'|'signature'|'shield'|'table'}/><h3>{tool.title}</h3><p>{tool.text}</p></article>)}</div>
    <div class="local-panel"><div class="local-symbol"><Icon name="shield"/></div><h2 class="preserve-lines">{t.localTitle}</h2><div><p>{t.localText}</p><p class="small-text">{t.localNote}</p><a class="text-link" href={href('privacy',lang)}>{t.localLink}<Icon name="arrow"/></a></div></div>
  </section>
  <section class="guides-section section">
    <div class="container"><div class="section-heading"><h2>{t.guideTitle}</h2><p>{t.guideIntro}</p><a class="text-link" href={href('guides',lang)}>{t.guideLink}<Icon name="right"/></a></div>
    <div class="guide-grid">{t.guideCards.map(([id,label,title],i) => <a class="guide-card" href={href(id,lang)}><div class:list={['guide-art',`guide-art-${i}`]} aria-hidden="true"><Icon name={i===0?'book':i===1?'text':'scan'}/></div><p>{label}</p><h3>{title}</h3><Icon name="arrow" class="guide-arrow"/></a>)}</div></div>
  </section>
  <section class="section container faq-section"><h2>{t.faqTitle}</h2><div class="faq-list">{t.faqs.map(([q,a]) => <details><summary>{q}<Icon name="plus"/></summary><p>{a}</p></details>)}</div></section>
  <section class="container closing"><h2 class="preserve-lines">{t.closingTitle}</h2><p>{t.closingText}</p><a class="button" href={href('getting-started',lang)}>{t.closingLink}<Icon name="right"/></a></section>
</Base>
